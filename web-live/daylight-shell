# This is a guest-local welcome banner: no network, background process or telemetry.
export HOME=/root TERM=xterm-256color ENV=/root/.daylight-shellrc
export PS1='daylight:\w$ '
cd / || exit 1
printf '\033[2J\033[H\033]0;Daylight Start\007'
kernel=$(uname -r)
memory=$(awk '/^MemTotal:/ {printf "%.0f", $2/1024; exit}' /proc/meminfo)
printf '\033[1;33m'
printf '        \ | /          DAYLIGHT START\n'
printf '      -- (o) --        Daylight Linux - Web Preview\n'
printf '         /\            --------------------------------------\n'
printf '     /\ /  \           Desktop : Fluxbox\n'
printf '    /  V    \          Kernel  : %s\n' "$kernel"
printf '   /__________\        Memory  : %s MiB available to Linux\n' "$memory"
printf '\033[0m\n'
printf '%s\n' 'Welcome to Daylight. Your terminal is ready.' \
    'Try: uname -a    free -m    top    ls    vi' \
    'Right-click the wallpaper for the menu. Calculator is optional.' \
    '' \
    'Developer: Hamdy Abou El Anein | info@daylightlinux.ch' \
    'Temporary browser preview: no host disks or external guest network.' \
    'Technical base: Alpine Linux x86. Full Daylight uses Raspberry Pi OS.'
printf '\n'
# PID 1 will announce readiness only after this terminal is visible and focused.
: > /run/daylight-shell-ready
exec /bin/sh -i
