[Unit]
Description=Optional Daylight boot counter (explicit opt-in)
[Timer]
OnBootSec=90s
RandomizedDelaySec=300s
AccuracySec=30s
Unit=daylight-telemetry.service
[Install]
WantedBy=timers.target
