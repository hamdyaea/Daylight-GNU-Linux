{
  "layer": "top",
  "position": "top",
  "modules-left": [
    "custom/daylight",
    "wlr/taskbar"
  ],
  "modules-right": [
    "clock"
  ],
  "custom/daylight": {
    "format": "Daylight GNU/Linux",
    "on-click": "wtype -M logo -k space -m logo"
  },
  "wlr/taskbar": {
    "format": "{icon}",
    "on-click": "activate"
  },
  "clock": {
    "format": "{:%H:%M}"
  }
}
