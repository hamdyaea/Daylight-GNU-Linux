[begin] (Daylight GNU/Linux)
 [exec] (Terminal) {/usr/bin/daylight-terminal}
 [exec] (Search applications) {/usr/bin/daylight app launcher}
 [exec] (Files) {/usr/bin/pcmanfm}
 [exec] (Daylight Control Center) {/usr/bin/daylight control-center}
 [exec] (Desktop settings) {/usr/bin/daylight app settings}
 [exec] (System monitor) {/usr/bin/daylight app monitor}
 [exec] (System information) {/usr/bin/daylight app info}
 [separator]
 [submenu] (Daylight applications)
  [exec] (Password generator) {/usr/bin/daylight app password}
  [exec] (Temperature converter) {/usr/bin/daylight app temperature}
  [exec] (Days calculator) {/usr/bin/daylight app days}
  [exec] (Local network information) {/usr/bin/daylight app connect}
  [exec] (Sun and Moon) {/usr/bin/daylight app sky}
  [exec] (Text to speech) {/usr/bin/daylight app speech}
  [exec] (Alarm) {/usr/bin/daylight app alarm}
 [end]
 [submenu] (Games)
  [exec] (Daylight Shardturn) {/usr/bin/daylight app shardturn}
  [exec] (Daylight Battle Cards) {/usr/bin/daylight app cards}
  [exec] (Daylight Memory Game) {/usr/bin/daylight app memory}
  [exec] (Daylight Tournament) {/usr/bin/daylight app tournament}
  [exec] (Daylight Dice) {/usr/bin/daylight app dice}
  [exec] (Daylight Coin Flip) {/usr/bin/daylight app coin}
  [exec] (Daylight Slots) {/usr/bin/daylight app slots}
  [exec] (Daylight Basketball) {/usr/bin/daylight app basketball}
  [exec] (Daylight Rock Paper Scissors Lizard Spock) {/usr/bin/daylight app rpsls}
  [exec] (Daylight Lottery) {/usr/bin/daylight app lottery}
  [exec] (Daylight Guess the Number) {/usr/bin/daylight app guess}
 [end]
 [submenu] (System applications)
  [include] (/etc/X11/fluxbox/fluxbox-menu)
 [end]
 [submenu] (Workspaces)
  [workspaces] (Workspaces)
 [end]
 [separator]
 [reconfig] (Reload window manager settings)
 [exit] (Log out of Daylight)
[end]
