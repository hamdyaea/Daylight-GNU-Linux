# This rcfile is used only by Daylight Terminal. Existing user files are not edited.
if [ -r "$HOME/.bashrc" ]; then . "$HOME/.bashrc"; fi
case $- in
 *i*) if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ] && [ "${DAYLIGHT_FETCH_SHOWN:-0}" != 1 ]; then
        export DAYLIGHT_FETCH_SHOWN=1
        if [ "$(/usr/bin/daylight settings get fetch)" = on ]; then /usr/bin/daylight info; fi
      fi ;;
esac
