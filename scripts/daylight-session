#!/bin/sh
# Developer: Hamdy Abou El Anein
# Contact: contact@daylightlinux.ch
# SPDX-License-Identifier: GPL-3.0-only
set -eu
export XDG_CURRENT_DESKTOP=Daylight:Fluxbox
export DAYLIGHT_SESSION=1
export GTK_THEME="${GTK_THEME:-Adwaita:dark}"
config=$(/usr/bin/daylight setup-session)
# Fluxbox initializes its compatibility directory even with -rc. If absent,
# upstream setupConfigFiles also overwrites the supplied rc file. Create only
# the directory first; never replace an existing classic Fluxbox configuration.
(umask 077; mkdir -p "$HOME/.fluxbox")
wallpaper=$(/usr/bin/daylight settings get wallpaper)
/usr/bin/feh --no-fehbg --bg-fill "/usr/share/backgrounds/daylight/$wallpaper"
conky_pid=
wm_pid=
cleanup() {
    if [ -n "$conky_pid" ]; then kill "$conky_pid" 2>/dev/null || :; fi
    if [ -n "$wm_pid" ]; then kill "$wm_pid" 2>/dev/null || :; fi
}
trap cleanup EXIT HUP INT TERM
/usr/bin/fluxbox -rc "$config/fluxbox/init" &
wm_pid=$!
if [ "$(/usr/bin/daylight settings get monitor)" = on ]; then
    /usr/bin/conky -c "$config/conky.conf" &
    conky_pid=$!
fi
wait "$wm_pid"
