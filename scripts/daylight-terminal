set -eu
# Prefer Terminator for its native copy/paste shortcuts and context menu.
# Fall back to xterm when running on a minimal existing installation.
if [ -x /usr/bin/terminator ]; then
    if [ "$#" -gt 0 ]; then
        exec /usr/bin/terminator -x "$@"
    fi
    exec /usr/bin/terminator -x /usr/lib/daylight/interactive-shell
fi
if [ "$#" -gt 0 ]; then
    exec /usr/bin/xterm -fa 'DejaVu Sans Mono' -fs 11 -bg '#101721' -fg '#f0e9d9' -e "$@"
fi
exec /usr/bin/xterm -fa 'DejaVu Sans Mono' -fs 11 -bg '#101721' -fg '#f0e9d9' -e /usr/lib/daylight/interactive-shell
