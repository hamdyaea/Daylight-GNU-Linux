[Unit]
Description=Daylight live CI check (explicit kernel flag only)
After=lightdm.service
ConditionKernelCommandLine=daylight.smoke=1
[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/daylight/live-smoke.sh
StandardInput=null
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=260
[Install]
WantedBy=multi-user.target
