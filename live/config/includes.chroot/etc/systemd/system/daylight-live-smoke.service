[Unit]
Description=Daylight live validation (explicit test flag or dedicated virtual test channel only)
After=lightdm.service systemd-udev-trigger.service
ConditionKernelCommandLine=|daylight.smoke=1
ConditionPathExists=|/dev/virtio-ports/org.daylightlinux.test
[Service]
Type=oneshot
ExecStart=/bin/sh /usr/lib/daylight/live-smoke.sh
StandardOutput=journal+console
StandardError=journal+console
TimeoutStartSec=230
[Install]
WantedBy=multi-user.target
