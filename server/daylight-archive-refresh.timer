[Unit]
Description=Renew Daylight APT signatures daily before their 30-day expiry
[Timer]
OnCalendar=daily
RandomizedDelaySec=2h
Persistent=true
Unit=daylight-archive-refresh.service
[Install]
WantedBy=timers.target
